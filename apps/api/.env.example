NODE_ENV=development
PORT=3001

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=als_inventory
DB_PASSWORD=als_inventory_dev
DB_NAME=als_inventory

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Unset locally (allows all origins). In production set to your Vercel
# deployment URL(s), comma-separated, e.g.:
# CORS_ORIGIN=https://als-inventory.vercel.app
CORS_ORIGIN=

# Signed, stored erasure certificates (remediation plan step 29). Unset =
# off: certificates are built on every download, unsigned, nothing stored.
# An Ed25519 private key, PKCS#8 PEM, base64-encoded - keep it a Railway
# secret, never commit it:
#   openssl genpkey -algorithm ed25519 -out cert-signing.pem
#   base64 -w0 cert-signing.pem
# A key that is set but unreadable stops the API from starting.
CERT_SIGNING_KEY=
# Retired public keys still published for old certificates (SPKI PEM,
# base64, comma-separated). Optional.
CERT_VERIFY_PUBLIC_KEYS=

# Public certificate check, GET /verify/keys and /verify/<id> (step 30).
# Off (both 404) unless exactly 1. The QR code on a signed certificate
# points at PUBLIC_VERIFY_BASE_URL/verify/<id> - the API's public address.
PUBLIC_VERIFY_ENABLED=
PUBLIC_VERIFY_BASE_URL=
